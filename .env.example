# Supabase project settings (public values may be sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never prefix service credentials with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Use a long random value, e.g. openssl rand -hex 32. Keep stable after launch.
AVATAR_HMAC_SECRET=
# Cloudinary product environment (signed image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Signed upload preset: authenticated assets, max 8 MB, jpg/png/webp only.
CLOUDINARY_UPLOAD_PRESET=
# Optional Geoapify: Places API & styled map tiles (free 3,000 req/day).
# Without a key the app uses standard OpenStreetMap tiles automatically.
NEXT_PUBLIC_GEOAPIFY_KEY=
# Optional Gemini, server only. Manual reporting and comments work without it.
GEMINI_API_KEY=
# Confirm an available model in your Google AI project before configuring.
GEMINI_MODEL=gemini-3.1-flash-lite
# Canonical public origin, used for OAuth and request-origin checks.
# Local dev: http://localhost:3000 | Production: https://api-blitz-three.vercel.app
NEXT_PUBLIC_SITE_URL=https://api-blitz-three.vercel.app
# Seed only; requires a real Google test user already in Supabase Auth.
SEED_AUTHOR_ID=

# Note on Google OAuth:
# Configure your Google Client ID and Client Secret directly in the Supabase Dashboard
# under Authentication -> Providers -> Google. Set the Authorized Redirect URI in Google Cloud Console
# to: https://<your-supabase-project-ref>.supabase.co/auth/v1/callback
